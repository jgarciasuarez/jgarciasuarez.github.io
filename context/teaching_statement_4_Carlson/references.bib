@article{SVL_C_and_G,
title = {Seismo-VLAB: A software for wave propagation and soil-structure interaction analyses},
journal = {Journal of Computing in Civil Engineering},
year = {submitted},
author = {Kusanovic, Danilo S. and Seylabi, Elnaz and Ayoubi, Peyman and Nguyen, Kien T. and Garcia-Suarez, Joaquin and Kottke, Albert R. and Asimaki, Domniki},
abstract = {Accurate quantification of soil-structure interaction (a.k.a SSI) effects during earthquakes is critical in the design of earthquake resistant structures. Currently, dynamic SSI analyses are carried out using two families of methods, referred to as direct and substructure. In general, these methods resort to generate a wave-field in a truncated domain, for which it is required both a boundary representation that perfectly absorbs the scattered waves, and a source representation that enables the consistent prescription of input motions. Unfortunately, such features are sometimes difficult to find or every so often are not available in commercial and open-source software. Therefore, such capabilities are not broadly available to researchers and practicing engineers in this field. To tackle these limitations, we develop \texttt{Seismo-VLAB} (\texttt{SVL}) an open-source software designed for simulations of wave propagation and SSI problems. In this regard, we implement the so-called Domain Reduction Method (DRM), Perfectly-Matched-Layers (PMLs), and Domain-Decomposition Method (DDM) needed for this purpose. Additionally, we incorporate advanced modeling techniques and parallel computing capabilities to optimize the cost associated with large scale problems. We are aware that there are several commercial and open-source options that can perform similar requirements; however, we want to present a self-contained alternative that may benefit some enthusiastic developers and users to contribute and experiment with this open-source project. In this work, we not only showcase and validate different features available in \texttt{SVL}, but also we demonstrate the coupled DRM-PML technique to be a key factor for solving wave propagation and SSI problems. Finally, we present two useful application using the implemented features--namely, (1) we study the SSI effects on the site and structural response for a 3D real building problem, and (2) we evaluate the performance of a 2D base-isolated building due to basin effects. The \texttt{SVL} code is currently being disseminated for broader use to researchers and practicing engineers throughout its website \url{http://seismovlab.com} where it can be freely downloaded.}
}
