@article{peeling,
	doi = {10.1088/0022-3727/8/13/005},
	url = {https://doi.org/10.1088/0022-3727/8/13/005},
	year = 1975,
	month = {sep},
	publisher = {{IOP} Publishing},
	volume = {8},
