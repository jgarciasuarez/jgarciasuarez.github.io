@article{Cambridge_guys,
author = {Woodhouse, Jim  and Putelat, Thibaut  and McKay, Andrew },
title = {Are there reliable constitutive laws for dynamic friction?},
journal = {Philosophical Transactions of the Royal Society A: Mathematical, Physical and Engineering Sciences},
volume = {373},
number = {2051},
pages = {20140401},
year = {2015},
doi = {10.1098/rsta.2014.0401},

URL = {https://royalsocietypublishing.org/doi/abs/10.1098/rsta.2014.0401},
eprint = {https://royalsocietypublishing.org/doi/pdf/10.1098/rsta.2014.0401}
,
    abstract = { Structural vibration controlled by interfacial friction is widespread, ranging from friction dampers in gas turbines to the motion of violin strings. To predict, control or prevent such vibration, a constitutive description of frictional interactions is inevitably required. A variety of friction models are discussed to assess their scope and validity, in the light of constraints provided by different experimental observations. Three contrasting case studies are used to illustrate how predicted behaviour can be extremely sensitive to the choice of frictional constitutive model, and to explore possible experimental paths to discriminate between and calibrate dynamic friction models over the full parameter range needed for real applications. }
}
