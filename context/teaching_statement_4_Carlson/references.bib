@article{RABINOWICZ_1958,
title = {The effect of size on the looseness of wear fragments},
journal = {Wear},
volume = {2},
number = {1},
pages = {4-8},
year = {1958},
issn = {0043-1648},
doi = {https://doi.org/10.1016/0043-1648(58)90335-1},
url = {https://www.sciencedirect.com/science/article/pii/0043164858903351},
author = {Ernest Rabinowicz},
abstract = {Whether a fragment transferred during sliding comes off as a loose wear particle is shown to depend on whether its elastic energy exceeds the surface energy at its point of attachment. Calculations show that, for an equiaxed fragment, there is a critical size, such that smaller fragments remain adherent while larger fragments come off in loose form. Experimental support for this critical size concept is cited. The material parameters involved are such that smaller fragments are formed with hard metals than with soft metals, thus explaining the better surface finish during sliding observed with the former.
Zusammenfassung
Ein Teilchen, das zuerst während des Gleitens auf die Kontrafläche übertragen wurde, kann von dieser Oberfläche schliesslich nur abgetrennt werden wenn die elastische Energie des Teilchens grösser ist als die Oberflächenenergie am Kontaktpunkt. Berechnungen für halbkugelförmige Teilchen zeigen, dass eine kritische Teilchengrösse besteht: kleinere Teilchen bleiben haften, nur grössere Bruckstücke vermögen sich abzulösen. Diese Vorstellung wird durch Versuche gestützt. Aus harten Metallen enstehen kleinere Trümmer als aus weichen und zwar wegen der Art der Materialkonstanten; dies erklärt auch die bessere Oberflächenbeschaffenheit, die bei Gleitversuchen mit harten Metallen gefunden wurde.}
}
