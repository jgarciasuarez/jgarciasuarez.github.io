@article{RABINOWICZ_1964,
title = {Practical uses of the surface energy criterion},
journal = {Wear},
volume = {7},
number = {1},
pages = {9-22},
year = {1964},
issn = {0043-1648},
doi = {https://doi.org/10.1016/0043-1648(64)90074-2},
url = {https://www.sciencedirect.com/science/article/pii/0043164864900742},
author = {E. Rabinowicz},
abstract = {The ratio of surface energy to hardness (the Wp ratio) of sliding surfaces has the dimensions of length, and many length parameters of sliding systems, including the diameters of loose and of adherent wear particles, the equilibrium peak-to-trough surface roughness, the diameter of junctions, and the size of the smallest abrasive particles which give full abrasive action, are shown to be proportional to Wp. At very low loads, when the real area of contact has a diameter smaller than that of the wear particles for that system, new effects are encountered, leading to low wear rates and the production of smooth surfaces.}
}
