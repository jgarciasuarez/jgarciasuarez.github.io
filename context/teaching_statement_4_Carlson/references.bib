@article{circular_cavity_dyan,
    author = {CROZIER, R. J. M. and HUNTER, S. C.},
    title = "{SIMILARITY SOLUTION FOR THE RAPID UNIFORM EXPANSION OF A CYLINDRICAL CAVITY IN A COMPRESSIBLE ELASTIC-PLASTIC SOLID}",
    journal = {The Quarterly Journal of Mechanics and Applied Mathematics},
    volume = {23},
    number = {3},
    pages = {349-363},
    year = {1970},
    month = {08},
    abstract = "{In a previous paper (1) the authors gave the solution to the problem of the dynamic expansion of a spherical cavity at a uniform rate in a compressible elastic-plastic solid.The present paper is concerned with the parallel problem for a cylindrical cavity. As for the spherical case, the situation in which the cavity radius expands at a uniform speed V0 from zero radius yields to a similarity solution in which stress, density and particle velocity are functions of a single variable η = r/t. In the present paper t is time (as in (1)) while r is now the cylindrical polar coordinate r = (x2+y2)1/2.The principal result of the paper is the calculation of the cavity pressure P as a function of V0. For sufficiently small V0 an analytic solution is obtained; for the larger values of V0, P is determined numerically.}",
    issn = {0033-5614},
    doi = {10.1093/qjmam/23.3.349},
    url = {https://doi.org/10.1093/qjmam/23.3.349},
    eprint = {https://academic.oup.com/qjmam/article-pdf/23/3/349/5290448/23-3-349.pdf},
}
@article{circular_cavity_hardening,
    author = {CHADWICK, P.},
    title = "{THE QUASI-STATIC EXPANSION OF A SPHERICAL CAVITY IN METALS AND IDEAL SOILS}",
    journal = {The Quarterly Journal of Mechanics and Applied Mathematics},
    volume = {12},
    number = {1},
    pages = {52-71},
    year = {1959},
    month = {01},
    abstract = "{An infinite medium of ideal soil contains a single spherical cavity within which a slowly increasing pressure is applied. The analysis of stress in the resulting plastic-elastic system, in conjunction with the flow rule associated with the Coulomb law of failure, leads to an expression for the radial displacement of the soil. It is found, in particular, that the radius of the cavity increases indefinitely as the applied pressure approaches a finite limiting value. Since the work done at the cavity wall also increases without bound this pressure cannot be attained physically.When the angle of shearing resistance of the soil is zero the Coulomb law and flow rule are, under conditions of radial symmetry, formally identical to the yield criteria of Tresca and von Mises and their associated flow rules. A special case of the analysis is hence appropriate to the expansion of a spherical cavity in a non-hardening metal. Calculations have been carried out for copper and a comparison is made with numerical results obtained from an alternative solution due to Hill (1). It is shown that the inclusion of work-hardening does not alter the behaviour of the medium qualitatively.If, on the completion of loading, the pressure exceeds a certain limit further plastic flow takes place round the cavity on unloading. Equations are obtained from which can be calculated the residual stresses and displacement at any stage of the unloading process.}",
    issn = {0033-5614},
    doi = {10.1093/qjmam/12.1.52},
    url = {https://doi.org/10.1093/qjmam/12.1.52},
    eprint = {https://academic.oup.com/qjmam/article-pdf/12/1/52/5458106/12-1-52.pdf},
}

